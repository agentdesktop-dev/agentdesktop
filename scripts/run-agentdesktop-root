#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
workspace_dir="$(cd -- "${script_dir}/.." && pwd)"
local_api_uid="$(id -u)"

cargo build \
  --manifest-path "${workspace_dir}/Cargo.toml" \
  --bin agentdesktop

exec "${script_dir}/cargo-sudo-runner" \
  "${workspace_dir}/target/debug/agentdesktop" \
  daemon \
  --local-api-uid "${local_api_uid}" \
  "$@"
