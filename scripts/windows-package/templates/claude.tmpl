#!/bin/sh
# Managed launcher for Claude Code, extensionless for Git Bash (MSYS) PATH
# search. Generated by your organization's own package build from the
# agentdesktop packaging recipe. Neither this file nor the program binary is
# distributed by the agentdesktop project.
# Every Claude box sets CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST: refuse to start
# a boxed launch from inside a box.
if [ -n "$CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST" ]; then
  echo "claude: refusing to launch claude from inside an agentdesktop box" >&2
  exit 1
fi
# A leading "/" in an argument (e.g. "/help") must reach the box unchanged,
# not be converted to a Windows path by MSYS.
export MSYS_NO_PATHCONV=1
exec "{{agentdesktopInstallPath}}\agentdesktop.exe" run --wait --socket "//./pipe/agentdesktop-user-$USERNAME" claude -- "$@"
