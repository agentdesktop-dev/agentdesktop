@echo off
rem Managed launcher for Claude Code, generated by your organization's own
rem package build from the agentdesktop packaging recipe. Neither this file
rem nor the program binary is distributed by the agentdesktop project.
rem Every Claude box sets CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST: refuse to
rem start a boxed launch from inside a box.
if defined CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST (
  echo claude: refusing to launch claude from inside an agentdesktop box 1>&2
  exit /b 1
)
rem Arguments are forwarded inline (%*), which keeps balanced-quoted
rem arguments intact so the daemon can refuse the ones carrying " % ^ & | < > !.
rem Residual: metacharacters inside cmd arguments follow cmd's own parsing,
rem exactly as for any .cmd on PATH; this launcher neither improves nor
rem worsens it (an UNQUOTED metacharacter reaching this line, for example
rem from an escaped ^&, is re-parsed by cmd before the daemon can refuse
rem it). Pass such arguments from PowerShell or Git Bash.
"{{agentdesktopInstallPath}}\agentdesktop.exe" run --wait --socket "\\.\pipe\agentdesktop-user-%USERNAME%" claude -- %*
exit /b %ERRORLEVEL%
