# yaml-language-server: $schema=./schema/desired-config.json
inferenceGateways:
  corporate:
    url: https://gateway.example.com
    authentication:
      type: controllerJwt
      audience: agentgateway

programs:
  openCode:
    inferenceGateway: corporate
    model: gpt-5.6-terra
    models:
      gpt-5.6-terra:
        name: GPT 5.6 Terra
        limit:
          context: 200000
          output: 65536
    managedConfig:
      autoupdate: false
      permission:
        edit: ask
        bash: ask
