{
  "name": "@agentdesktop/desktop-web",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Desktop Tauri tray application",
  "type": "module",
  "scripts": {
    "generate:icons": "node scripts/generate-icons.mjs",
    "icons": "pnpm generate:icons && node scripts/tauri.mjs icon ../../frontend/desktop/assets/app-icon.png && node scripts/generate-icons.mjs --finalize",
    "dev:desktop": "node scripts/tauri.mjs dev",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project=storybook",
    "start": "node scripts/tauri.mjs dev",
    "tauri": "node scripts/tauri.mjs",
    "test:package-macos": "node --test scripts/package-macos.test.mjs",
    "test:package-windows": "node --test scripts/package-windows.test.mjs",
    "dist": "node scripts/tauri.mjs build",
    "dist:mac": "node scripts/package-macos.mjs",
    "dist:win": "node scripts/package-windows.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@agentdesktop/ui": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.62.1",
    "storybook": "^10.5.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
