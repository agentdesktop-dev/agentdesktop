{
  "name": "@agentdesktop/desktop-web",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Desktop Tauri tray application",
  "type": "module",
  "scripts": {
    "generate:icons": "node scripts/generate-icons.mjs",
    "icons": "pnpm generate:icons && node scripts/tauri.mjs icon ../../frontend/desktop/assets/app-icon.png",
    "dev:desktop": "node scripts/tauri.mjs dev",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/tauri.mjs dev",
    "tauri": "node scripts/tauri.mjs",
    "dist": "node scripts/tauri.mjs build",
    "dist:mac": "node scripts/tauri.mjs build --bundles app,dmg",
    "dist:win": "node scripts/tauri.mjs build --bundles nsis"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@agentdesktop/ui": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
