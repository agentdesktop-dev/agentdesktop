# yaml-language-server: $schema=https://agentgateway.dev/schema/config
#
# The controller publishes the public key corresponding to gatewayJwt at
# http://127.0.0.1:8080/.well-known/jwks.json.
#
# Run with ANTHROPIC_API_KEY set:
#   agentgateway -f ./agentgateway.yaml.example

llm:
  port: 4000
  policies:
    jwtAuth:
      issuer: agentdesktop-controller
      audiences:
      - agentgateway
      jwks:
        url: http://127.0.0.1:8080/.well-known/jwks.json

  models:
  - name: '*'
    provider: anthropic
    params:
      apiKey: $ANTHROPIC_API_KEY
