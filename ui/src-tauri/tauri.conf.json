{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentplane",
  "version": "0.1.0",
  "identifier": "dev.agentplane.app",
  "build": {
    "beforeDevCommand": "pnpm frontend:dev",
    "beforeBuildCommand": "pnpm frontend:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Agentplane tray client",
    "longDescription": "A lightweight Agentplane tray client for checking daemon and local agent discovery status."
  }
}
