{
  "name": "agentdesktop-tray",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Desktop Tauri tray application",
  "type": "module",
  "scripts": {
    "generate:icons": "node scripts/generate-icons.mjs",
    "icons": "npm run generate:icons && tauri icon assets/app-icon.png",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tauri dev",
    "tauri": "tauri",
    "dist": "tauri build",
    "dist:mac": "tauri build --bundles app,dmg",
    "dist:win": "tauri build --bundles nsis"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
