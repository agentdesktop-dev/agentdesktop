# yaml-language-server: $schema=./schema/desired-config.json
inferenceGateway:
  url: http://localhost:4000
  authentication:
    type: controllerJwt
    audience: agentgateway

programs:
  claudeCode:
    companyAnnouncements: ["Managed by AgentDesktop"]
    env:
      COMPANY_ENVIRONMENT: production
    permissions:
      defaultMode: plan
