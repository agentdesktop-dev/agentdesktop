{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Desktop",
  "version": "0.1.0",
  "identifier": "dev.agentdesktop.tray",
  "build": {
    "beforeDevCommand": {
      "cwd": "../../frontend",
      "script": "pnpm --filter @agentdesktop/desktop-web dev"
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "cwd": "../../frontend",
      "script": "pnpm --filter @agentdesktop/desktop-web build"
    },
    "frontendDist": "../../frontend/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Desktop",
        "width": 940,
        "height": 680,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local Agent Desktop gateway controls",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
