project_id = "my-gcp-project"
zone       = "us-central1-a"

instance_name = "agentdesktop-managed"
public_host    = null

# Restrict this to the public IPv4 addresses of development clients and
# administrator workstations. Use 0.0.0.0/0 only for a deliberate isolated test.
client_source_ranges = [
  "203.0.113.10/32",
]

# Leave both values null to use the allocated static IPv4 address directly.
# To use Cloud DNS, set public_host to a hostname and dns_managed_zone to the
# resource name (not DNS suffix) of its existing managed zone.
dns_managed_zone = null